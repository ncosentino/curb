{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Curb guidance contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "agents", "instructions", "docs", "review", "validation", "representativePaths"],
  "properties": {
    "$schema": { "const": "./guidance.schema.json" },
    "schemaVersion": { "const": 1 },
    "agents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "maxLines", "maxBytes", "claude", "copilot"],
      "properties": {
        "path": { "const": "AGENTS.md" },
        "maxLines": { "type": "integer", "minimum": 1, "maximum": 60 },
        "maxBytes": { "type": "integer", "minimum": 1, "maximum": 3072 },
        "claude": { "const": "CLAUDE.md" },
        "copilot": { "const": ".github/copilot-instructions.md" }
      }
    },
    "instructions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "sharedRoot", "projectRoot", "imports", "maxFileLines", "maxFileBytes", "maxMatchedLines", "maxMatchedBytes"],
      "properties": {
        "root": { "const": ".github/instructions" },
        "sharedRoot": { "const": ".github/instructions/genesis" },
        "projectRoot": { "const": ".github/instructions/curb" },
        "imports": { "const": ".github/instructions/imports.json" },
        "maxFileLines": { "type": "integer", "minimum": 1, "maximum": 100 },
        "maxFileBytes": { "type": "integer", "minimum": 1, "maximum": 8192 },
        "maxMatchedLines": { "type": "integer", "minimum": 1, "maximum": 300 },
        "maxMatchedBytes": { "type": "integer", "minimum": 1, "maximum": 16384 }
      }
    },
    "docs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["map", "navigation", "adrIndex", "generatedReference", "referenceGenerator"],
      "properties": {
        "map": { "$ref": "#/$defs/path" },
        "navigation": { "$ref": "#/$defs/path" },
        "adrIndex": { "$ref": "#/$defs/path" },
        "generatedReference": { "$ref": "#/$defs/path" },
        "referenceGenerator": { "$ref": "#/$defs/path" }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill", "resolver", "inventory"],
      "properties": {
        "skill": { "$ref": "#/$defs/path" },
        "resolver": { "$ref": "#/$defs/path" },
        "inventory": { "$ref": "#/$defs/path" }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runnerProject", "commandDefinition", "targetDefinition", "testProject", "guidanceTarget", "guidanceTestClass"],
      "properties": {
        "runnerProject": { "$ref": "#/$defs/path" },
        "commandDefinition": { "$ref": "#/$defs/path" },
        "targetDefinition": { "$ref": "#/$defs/path" },
        "testProject": { "$ref": "#/$defs/path" },
        "guidanceTarget": { "const": "guidance" },
        "guidanceTestClass": { "const": "GuidanceContractTests" }
      }
    },
    "representativePaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/path" }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    }
  }
}
